<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_rounded"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ROW 1 : artwork + metadata + icon-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:gravity="top">

            <!-- Artwork -->
            <ImageView
                android:id="@+id/widget_artwork"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginEnd="12dp"
                android:scaleType="centerCrop"
                android:background="@drawable/widget_artwork_round"
                android:clipToOutline="true"
                android:contentDescription="@string/artwork" />

            <!-- Right Content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- top row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top|center_vertical"
                    android:layout_marginBottom="10dp">

                    <!-- title + artist -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingTop="4dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_title"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/widget_artist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/default_artist"
                            android:textColor="#B3FFFFFF"
                            android:textSize="14sp"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <!-- App Icon -->
                    <ImageView
                        android:id="@+id/widget_app_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="10dp"
                        android:src="@mipmap/ic_launcher"
                        android:scaleType="centerCrop"
                        android:background="@drawable/widget_app_icon_round"
                        android:clipToOutline="true"
                        android:contentDescription="@string/app_icon" />

                </LinearLayout>

                <!-- Progress -->
                <ProgressBar
                    android:id="@+id/widget_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="1000"
                    android:progress="700"
                    android:progressDrawable="@drawable/widget_progress_track" />

                <!-- Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_time_current"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/default_start_time"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/widget_time_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_end_time"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ROW 2 : Controls-->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" >

            <ImageButton
                android:id="@+id/widget_btn_play"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_widget_play"
                android:background="@drawable/widget_play_btn_bg"
                android:contentDescription="@string/play_pause"
                android:scaleType="centerInside"
                android:padding="0dp" />

            <ImageButton
                android:id="@+id/widget_btn_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/widget_btn_play"
                android:layout_marginEnd="28dp"
                android:src="@drawable/ic_widget_prev"
                android:background="@android:color/transparent"
                android:contentDescription="@string/previous"
                android:scaleType="center" />

            <ImageButton
                android:id="@+id/widget_btn_shuffle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/widget_btn_prev"
                android:layout_marginEnd="28dp"
                android:src="@drawable/ic_widget_shuffle"
                android:background="@android:color/transparent"
                android:contentDescription="@string/shuffle"
                android:scaleType="center" />

            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/widget_btn_play"
                android:layout_marginStart="28dp"
                android:src="@drawable/ic_widget_next"
                android:background="@android:color/transparent"
                android:contentDescription="@string/next"
                android:scaleType="center" />

            <ImageButton
                android:id="@+id/widget_btn_repeat"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/widget_btn_next"
                android:layout_marginStart="28dp"
                android:src="@drawable/ic_widget_repeat"
                android:background="@android:color/transparent"
                android:contentDescription="@string/repeat"
                android:scaleType="center" />

        </RelativeLayout>

    </LinearLayout>

</FrameLayout>